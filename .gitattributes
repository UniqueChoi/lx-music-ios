# 默认：文本文件统一用 LF 存入仓库
* text=auto eol=lf

# 显式锁定：这些文件在 macOS/Linux 上必须保持 LF，否则无法执行
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.podspec   text eol=lf
Podfile     text eol=lf
*.m         text eol=lf
*.h         text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf

# 二进制文件，不做任何换行转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.ttf       binary
*.mp3       binary
*.ipa       binary
*.keystore  binary
